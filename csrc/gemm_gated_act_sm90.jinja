#include <cutlass/epilogue/thread/activation.h>
#include <cutlass/numeric_types.h>

#include "tvm_ffi_utils.h"

namespace flashinfer {
namespace gemm {

template <typename DTypeIn, typename DTypeOut, template <class> class ActivationFn, bool Pingpong>
cudaError_t GemmGatedActSM90Run(void* workspace, size_t workspace_size_in_bytes, void* w_ptr,
                                void* x_ptr, void* bias_ptr, void* d_ptr, float alpha,
                                float const* alpha_ptr, float beta, float const* scale_ptr,
                                int64_t m_fused, int64_t n_tokens, int64_t k, int64_t sm_count,
                                cudaStream_t stream);

}  // namespace gemm
}  // namespace flashinfer

using tvm::ffi::Optional;

namespace {

using DTypeIn = {{ dtype_in }};
using DTypeOut = {{ dtype_out }};
template <class T>
using ActivationFn = {{ activation }}<T>;

}  // namespace

void GemmGatedActSM90(TensorView workspace_buffer, TensorView a, TensorView weight,
                      Optional<TensorView> bias, Optional<TensorView> alpha_tensor,
                      Optional<TensorView> out_scale, TensorView out, double alpha,
                      int64_t sm_count, int64_t tactic) {
  CHECK_INPUT(a);
  CHECK_INPUT(weight);
  CHECK_INPUT(out);
  CHECK_INPUT(workspace_buffer);
  CHECK_DIM(2, a);
  CHECK_DIM(2, weight);
  CHECK_DIM(2, out);
  CHECK_INPUT_TYPE(a, {{ dl_dtype_in }});
  CHECK_INPUT_TYPE(weight, {{ dl_dtype_in }});
  CHECK_INPUT_TYPE(out, {{ dl_dtype_out }});
  CHECK_DEVICE(weight, a);
  CHECK_DEVICE(out, a);

  int64_t n_tokens = a.size(0);
  int64_t k = a.size(1);
  int64_t m_fused = weight.size(0);
  TVM_FFI_ICHECK_EQ(weight.size(1), k) << "weight and a must share K";
  TVM_FFI_ICHECK_EQ(m_fused % 16, 0) << "weight.size(0) must be divisible by 16";
  TVM_FFI_ICHECK_EQ(out.size(0), n_tokens) << "out.size(0) must equal a.size(0)";
  TVM_FFI_ICHECK_EQ(out.size(1), m_fused / 2) << "out.size(1) must equal weight.size(0) / 2";

  void* bias_ptr = nullptr;
  float beta = 0.0f;
  if (bias.has_value()) {
    CHECK_INPUT(bias.value());
    CHECK_DIM(1, bias.value());
    CHECK_INPUT_TYPE(bias.value(), {{ dl_dtype_bias }});
    TVM_FFI_ICHECK_EQ(bias.value().size(0), m_fused) << "bias must have weight.size(0) elements";
    bias_ptr = bias.value().data_ptr();
    beta = 1.0f;
  }
  float const* alpha_ptr = nullptr;
  if (alpha_tensor.has_value()) {
    CHECK_INPUT_TYPE(alpha_tensor.value(), dl_float32);
    TVM_FFI_ICHECK_EQ(alpha_tensor.value().numel(), 1) << "alpha tensor must be a scalar";
    alpha_ptr = static_cast<float const*>(alpha_tensor.value().data_ptr());
  }
  float const* scale_ptr = nullptr;
  if (out_scale.has_value()) {
    CHECK_INPUT_TYPE(out_scale.value(), dl_float32);
    TVM_FFI_ICHECK_EQ(out_scale.value().numel(), 1) << "out_scale must be a scalar";
    scale_ptr = static_cast<float const*>(out_scale.value().data_ptr());
  }

  ffi::CUDADeviceGuard device_guard(a.device().device_id);
  const cudaStream_t stream = get_stream(a.device());
  auto workspace_size_in_bytes = workspace_buffer.numel() * get_element_size(workspace_buffer);

  cudaError_t status;
  if (tactic == 1) {  // cooperative schedule (128x256 tile)
    status = flashinfer::gemm::GemmGatedActSM90Run<DTypeIn, DTypeOut, ActivationFn, false>(
        workspace_buffer.data_ptr(), workspace_size_in_bytes, weight.data_ptr(), a.data_ptr(),
        bias_ptr, out.data_ptr(), static_cast<float>(alpha), alpha_ptr, beta, scale_ptr, m_fused,
        n_tokens, k, sm_count, stream);
  } else {  // pingpong schedule (128x128 tile)
    status = flashinfer::gemm::GemmGatedActSM90Run<DTypeIn, DTypeOut, ActivationFn, true>(
        workspace_buffer.data_ptr(), workspace_size_in_bytes, weight.data_ptr(), a.data_ptr(),
        bias_ptr, out.data_ptr(), static_cast<float>(alpha), alpha_ptr, beta, scale_ptr, m_fused,
        n_tokens, k, sm_count, stream);
  }
  TVM_FFI_ICHECK(status == cudaSuccess)
      << "Failed to run GemmGatedActSM90: " << cudaGetErrorString(status);
}
